ALCHEMY_KEY=your_alchemy_api_key_here
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# Block the vault was deployed at — the start of the per-user event scan.
# Defaults to 0; set it to the deployment block to avoid scanning all history.
VAULT_DEPLOY_BLOCK=0
SUPABASE_URL=https://your-project.supabase.co
# Required — the service-role key (Supabase dashboard > Settings > API).
# It bypasses RLS so the bot can write alerts and block-checks; the public
# anon key is denied inserts. Keep this SECRET: server-side env only, never
# commit it and never expose it to the browser.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
BLOCK_POLL_INTERVAL_MS=2000
CHAIN=base-sepolia

# --- Operational surface ----------------------------------------------------
# Health server port — exposes GET /healthz (liveness JSON) and GET /metrics
# (Prometheus exposition format). Bound to 0.0.0.0.
HEALTH_PORT=9090
# /healthz returns 503 if no block has been checked for longer than
# BLOCK_POLL_INTERVAL_MS * 2 * MAX_HEALTHY_BLOCKS. Default is 30 blocks (~2 min
# at the 2s default poll interval).
MAX_HEALTHY_BLOCKS=30
# Consecutive block-check failures after which the RPC circuit breaker opens
# and the bot stops calling fetch/evaluate until a probe recovers it.
BREAKER_OPEN_AT=10
# While open, the breaker probes a cheap RPC call (getBlockNumber) every
# this many ms. Two consecutive successes close the breaker.
BREAKER_PROBE_INTERVAL_MS=30000
