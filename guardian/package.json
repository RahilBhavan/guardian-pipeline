{
  "name": "guardian-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Off-chain Guardian daemon \u2014 monitors Vault invariants live on Base L2.",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/bot.js",
    "build": "tsup src/bot.ts src/ha.ts src/once.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/health.test.ts test/evaluator.test.ts test/fixtures.test.ts test/stateHistory.test.ts test/accrue-sim.test.ts test/telemetry.test.ts test/morpho.test.ts",
    "parity": "node scripts/parity-check.mjs",
    "start:ha": "node dist/ha.js",
    "ha": "tsx src/ha.ts",
    "test:ha": "node --test --import tsx test/atomicMonitor.test.ts",
    "morpho": "tsx scripts/run-morpho.ts",
    "benchmark:morpho-detection": "tsx scripts/benchmark-morpho-detection.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "~2.12.0",
    "@opentelemetry/sdk-trace-node": "~2.12.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^11.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
