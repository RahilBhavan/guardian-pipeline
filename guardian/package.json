{
  "name": "guardian-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Off-chain Guardian daemon \u2014 monitors Vault invariants live on Base L2.",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "start": "node dist/bot.js",
    "build": "tsup src/bot.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/health.test.ts test/evaluator.test.ts test/fixtures.test.ts test/stateHistory.test.ts test/accrue-sim.test.ts",
    "parity": "node scripts/parity-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "dotenv": "^16.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.8.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
